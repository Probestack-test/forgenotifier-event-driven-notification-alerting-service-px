<?xml version="1.0" encoding="UTF-8"?>
<!--
  ProxyEndpoint – default
  Defines how Apigee handles inbound HTTP requests:
    1. PreFlow: security, rate limiting, transformation (all requests)
    2. Conditional Flows: one per operation from the OpenAPI spec
    3. PostFlow: logging, response transform (all requests)
    4. FaultRules: error handling (all fault scenarios)
-->
<ProxyEndpoint name="default">
  <Description>Default proxy endpoint generated from OpenAPI spec</Description>

  <!-- ═══ FAULT RULES ═══════════════════════════════════════════════ -->
  <FaultRules>
    <FaultRule name="QuotaExceeded">
      <Condition>(fault.name == "QuotaViolation")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-QuotaExceeded</Name></Step>
    </FaultRule>
    <FaultRule name="SpikeArrestViolation">
      <Condition>(fault.name == "SpikeArrestViolation")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-SpikeArrestViolation</Name></Step>
    </FaultRule>
    <FaultRule name="ThreatProtection">
      <Condition>(fault.name == "ExceededContainerDepth") or (fault.name == "ExceededObjectEntryNameLength") or (fault.name == "ExceededObjectEntryCount") or (fault.name == "ExceededArrayElementCount") or (fault.name == "ExceededStringValueLength")</Condition>
      <Step><Name>AM-SetErrorHeaders</Name></Step>
      <Step><Name>RF-ThreatViolation</Name></Step>
    </FaultRule>

    <!-- Default: catch all remaining faults -->
    <DefaultFaultRule name="DefaultFaultRule">
      <AlwaysEnforce>true</AlwaysEnforce>
      <Step>
        <Name>AM-SetErrorHeaders</Name>
      </Step>
      <Step>
        <Name>RF-UnexpectedError</Name>
        <Condition>(fault.name != "QuotaViolation") and
                   (fault.name != "SpikeArrestViolation") and
                   (fault.name != "InvalidApiKey") and
                   (fault.name != "FailedToResolveAPIKey")</Condition>
      </Step>
      <Step>
        <Name>ML-RequestLog</Name>
        <Condition>lookupcache.PC-LookupCache.cachehit == null or lookupcache.PC-LookupCache.cachehit == false</Condition>
      </Step>
    </DefaultFaultRule>
  </FaultRules>

  <!-- ═══ PRE-FLOW (every request) ═════════════════════════════════ -->
  <PreFlow name="PreFlow">
    <Request>
      <!-- Auth → Threat Protection → Rate Limit → Transform → Cache Lookup -->
      <Step>
        <Name>TP-JsonThreatProtection</Name>
      </Step>
      <Step>
        <Name>KV-GetJwtPublicKey</Name>
      </Step>
      <Step>
        <Name>VJ-VerifyJWT</Name>
      </Step>
      <Step>
        <Name>AM-SetJwtContext</Name>
      </Step>
      <Step>
        <Name>SA-SpikeArrest</Name>
      </Step>
      <Step>
        <Name>Q-ApiQuota</Name>
      </Step>
      <Step>
        <Name>AM-AddCorrelationId</Name>
      </Step>
      <Step>
        <Name>EV-ExtractPathParams</Name>
      </Step>
      <Step>
        <Name>AM-RequestTransform</Name>
      </Step>

    </Request>
    <Response>
      <!-- Transform → Echo Headers → Cache Populate → Log -->
      <Step>
        <Name>AM-EchoCorrelationId</Name>
      </Step>
      <Step>
        <Name>AM-ResponseTransform</Name>
      </Step>

    </Response>
  </PreFlow>

  <!-- ═══ OPERATION FLOWS (per OpenAPI path+method) ════════════════ -->
  <Flows>
    <Flow name="sendEmail">
      <Description>Send an HTML email notification [POST /notifications/email]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/notifications/email")</Condition>
    </Flow>
    <Flow name="sendSlackMessage">
      <Description>Send a message to a Slack channel [POST /notifications/slack]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/notifications/slack")</Condition>
    </Flow>
    <Flow name="sendWebhook">
      <Description>Trigger an outgoing HTTP webhook [POST /notifications/webhook]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/notifications/webhook")</Condition>
    </Flow>
    <Flow name="getNotificationHistory">
      <Description>Paginated audit log of sent notifications [GET /notifications/history]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/notifications/history")</Condition>
    </Flow>
    <Flow name="getNotificationById">
      <Description>Get specific notification details [GET /notifications/history/{notificationId}]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/notifications/history/*")</Condition>
    </Flow>
    <Flow name="listAlertRules">
      <Description>List all active alert rules [GET /alerts/rules]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/alerts/rules")</Condition>
    </Flow>
    <Flow name="createAlertRule">
      <Description>Create a new alert rule [POST /alerts/rules]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/alerts/rules")</Condition>
    </Flow>
    <Flow name="getAlertRuleById">
      <Description>Get alert rule by ID [GET /alerts/rules/{ruleId}]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "GET") and (proxy.pathsuffix MatchesPath "/alerts/rules/*")</Condition>
    </Flow>
    <Flow name="deleteAlertRule">
      <Description>Delete an alert rule [DELETE /alerts/rules/{ruleId}]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "DELETE") and (proxy.pathsuffix MatchesPath "/alerts/rules/*")</Condition>
    </Flow>
    <Flow name="evaluateAlerts">
      <Description>Manually evaluate all alert rules [POST /alerts/check]</Description>
      <Request/>
      <Response/>
      <Condition>(request.verb == "POST") and (proxy.pathsuffix MatchesPath "/alerts/check")</Condition>
    </Flow>

    <!-- Catch-all: 404 for any unmatched path -->
    <Flow name="UnmatchedPath">
      <Description>Returns 404 for requests that do not match any defined path</Description>
      <Request>
        <Step>
          <Name>RF-PathNotFound</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>

  <!-- ═══ POST-FLOW (only if no fault) ═════════════════════════════ -->
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>

  <!-- ═══ HTTP Proxy Connection ═════════════════════════════════════ -->
  <HTTPProxyConnection>
    <BasePath>/v1</BasePath>
    <Properties/>
    <VirtualHost>secure</VirtualHost>
  </HTTPProxyConnection>

  <RouteRule name="CacheRoute">
    <Condition>lookupcache.PC-LookupCache.cachehit == "true"</Condition>
    <!-- Route to null target when response is served from cache -->
  </RouteRule>
  <RouteRule name="DefaultRoute">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
