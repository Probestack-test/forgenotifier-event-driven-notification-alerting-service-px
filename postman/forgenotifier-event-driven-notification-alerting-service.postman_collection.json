      "method" : "GET",
      "description" : "Get specific notification details\n\nResponses:\n- 200: Detailed notification record.\n- 404: The requested notification record or alert rule does not exist.",
      "header" : [ ],
      "url" : {
        "raw" : "{{baseUrl}}/notifications/history/:notificationId",
        "host" : [ "{{baseUrl}}" ],
