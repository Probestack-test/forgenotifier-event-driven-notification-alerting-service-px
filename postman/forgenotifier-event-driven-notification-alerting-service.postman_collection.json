    "request" : {
      "method" : "DELETE",
      "description" : "Delete an alert rule\n\nResponses:\n- 204: Alert rule successfully deleted.\n- 404: The requested notification record or alert rule does not exist.",
      "header" : [ ],
      "url" : {
        "raw" : "{{baseUrl}}/alerts/rules/:ruleId",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "alerts", "rules", ":ruleId" ],
        "variable" : [ {
          "key" : "ruleId",
          "value" : "{{ruleId}}"
        } ]
      }
    },
    "response" : [ ]
  }, {
    "name" : "Manually evaluate all alert rules",
    "request" : {
      "method" : "POST",
      "description" : "Manually evaluate all alert rules\n\nResponses:\n- 200: Evaluation complete.\n- 500: Unexpected SMTP/Slack/Network error occurred.",
