    "type" : "bearer",
    "bearer" : [ {
      "key" : "token",
      "value" : "{{accessToken}}",
      "type" : "string"
    } ]
  },
  "variable" : [ {
    "key" : "baseUrl",
    "value" : "https://notifier.forgesphere.lightning.com/v1",
    "type" : "string",
    "description" : "Override with the base URL of the deployed Apigee proxy."
  }, {
    "key" : "accessToken",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "notificationType",
    "value" : "",
    "type" : "string",
    "description" : "Filter by the delivery channel."
  }, {
    "key" : "status",
    "value" : "",
    "type" : "string",
    "description" : "Filter by delivery status."
  }, {
    "key" : "correlationId",
    "value" : "",
    "type" : "string",
    "description" : "Filter by the job/task correlation ID."
  }, {
    "key" : "page",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "size",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "notificationId",
    "value" : "",
    "type" : "string"
  }, {
    "key" : "ruleId",
    "value" : "",
    "type" : "string"
  } ],
  "item" : [ {
    "name" : "Send an HTML email notification",
    "request" : {
      "method" : "POST",
      "description" : "Send an HTML email notification\n\nResponses:\n- 202: Email accepted for delivery by the SMTP relay.\n- 400: Invalid request body or missing fields (e.g., invalid email, missing payload).\n- 500: Unexpected SMTP/Slack/Network error occurred.",
      "header" : [ {
        "key" : "Content-Type",
        "value" : "application/json",
        "type" : "text"
      } ],
      "body" : {
        "mode" : "raw",
        "raw" : "{}",
        "options" : {
          "raw" : {
            "language" : "json"
          }
        }
      },
      "url" : {
        "raw" : "{{baseUrl}}/notifications/email",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "notifications", "email" ]
      }
    },
    "response" : [ ]
  }, {
    "name" : "Send a message to a Slack channel",
    "request" : {
      "method" : "POST",
