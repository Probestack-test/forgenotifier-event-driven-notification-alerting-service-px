        "raw" : "{{baseUrl}}/notifications/history?notificationType={{notificationType}}&status={{status}}&correlationId={{correlationId}}&page={{page}}&size={{size}}",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "notifications", "history" ],
        "query" : [ {
          "key" : "notificationType",
          "value" : "{{notificationType}}",
          "disabled" : true,
          "description" : "Filter by the delivery channel."
        }, {
          "key" : "status",
          "value" : "{{status}}",
          "disabled" : true,
          "description" : "Filter by delivery status."
        }, {
          "key" : "correlationId",
          "value" : "{{correlationId}}",
          "disabled" : true,
          "description" : "Filter by the job/task correlation ID."
        }, {
          "key" : "page",
          "value" : "{{page}}",
          "disabled" : true
        }, {
          "key" : "size",
          "value" : "{{size}}",
          "disabled" : true
        } ]
      }
    },
    "response" : [ ]
  }, {
