    "request" : {
      "method" : "POST",
      "description" : "Trigger an outgoing HTTP webhook\n\nResponses:\n- 202: Webhook triggered asynchronously.\n- 400: Invalid request body or missing fields (e.g., invalid email, missing payload).\n- 500: Unexpected SMTP/Slack/Network error occurred.",
      "header" : [ {
        "key" : "Content-Type",
        "value" : "application/json",
        "type" : "text"
