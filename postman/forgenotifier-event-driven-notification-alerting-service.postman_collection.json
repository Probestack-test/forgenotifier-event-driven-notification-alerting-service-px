{
  "info" : {
    "name" : "forgenotifier-event-driven-notification-alerting-service Postman Collection",
    "description" : "Centralized communication bus for the ForgeSphere platform. \nHandles all outgoing notifications including Email (SMTP), Slack messages, \nand generic outgoing Webhooks. \nTriggers alerts based on scheduled job failures, queue overload, \nor successful enhancement completions.\n\n\nOpenAPI version: 1.0.0",
    "schema" : "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
