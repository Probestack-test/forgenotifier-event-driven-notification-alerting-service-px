      "url" : {
        "raw" : "{{baseUrl}}/alerts/rules",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "alerts", "rules" ]
      }
    },
    "response" : [ ]
  }, {
    "name" : "Get alert rule by ID",
    "request" : {
      "method" : "GET",
      "description" : "Get alert rule by ID\n\nResponses:\n- 200: Alert rule details.\n- 404: The requested notification record or alert rule does not exist.",
      "header" : [ ],
      "url" : {
        "raw" : "{{baseUrl}}/alerts/rules/:ruleId",
        "host" : [ "{{baseUrl}}" ],
        "path" : [ "alerts", "rules", ":ruleId" ],
        "variable" : [ {
          "key" : "ruleId",
          "value" : "{{ruleId}}"
        } ]
